# ci-vm.env — decisions for the coordinator inside the CI VM.
# Copy to ci-vm.env, edit, keep mode 600 (it may carry the coordinator nsec).
# Everything here is passed as environment to the ngit-ci compose service.

# Repositories to watch: comma-separated npub1.../identifier entries.
# The tollgate mirror (maintainer npub rotated 2026-09-13, see the repo's
# .ngit/README.md "Pushing to the ngit mirror"):
NGIT_CI_REPOS='npub1nng5mxkdh2mu593twukfr7j3fk5wxfy0v8ujf0e5g8nwwtzlphhqksqpew/tollgate-module-basic-go'

# Operator policy. 'automatic' runs every trigger seen (this CI is ours and
# ephemeral); 'request-required' waits for a maintainer kind-9843 first.
NGIT_CI_EXECUTION_POLICY='automatic'

# Concurrency: 1 job at a time fits the 16 GB profile; 2-4 for the 32 GB box.
NGIT_CI_MAX_CONCURRENT_JOBS='2'

# Identity continuity across ephemeral boots: without this the coordinator
# mints a NEW nostr key every boot (results stay valid; the trust anchor
# churns). Generate once (nak key generate), store ONLY here + your vault:
# NGIT_CI_COORDINATOR_NSEC='nsec1...'

# Per-job container caps — the host resource ceiling is
# max-concurrent-jobs x these caps (measured budget in the runbook).
# 16 GB profile (serial jobs):    --memory=2500m --cpus=1.5
# 32 GB profile:                   --memory=4g --cpus=2
NGIT_CI_ACT_CONTAINER_OPTIONS='--memory=4g --memory-swap=4g --cpus=2 --pids-limit=2048'

# Job timeout: 1800 s default; the SDK/apk lanes want 2700-3600 s.
NGIT_CI_JOB_TIMEOUT_SECS='1800'

# act platform mapping (default: catthehacker medium images). Add entries if
# a workflow's runs-on label needs one:
# NGIT_CI_ACT_PLATFORMS='ubuntu-latest=ghcr.io/catthehacker/ubuntu:act-latest'

# FIRST-BOOT pre-pull of the job image so run #1 is warm. The OpenWrt SDK
# images for the release lanes stay on-demand (multi-GB, see runbook).
CI_PRESEED_IMAGES='ghcr.io/catthehacker/ubuntu:act-latest'

# Per-repo secrets (e.g. the Blossom/Nostr publish key) do NOT go here:
# put NGIT_CI_SECRET_<ALIAS>__NSEC_HEX=... lines in ngit-ci-secrets.env
# next to this file (mode 600) and add #ALIAS to the NGIT_CI_REPOS entry.
