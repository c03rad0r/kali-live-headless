# Secrets and generated artifacts — never commit these.
# ./config holds the Wi-Fi passphrase in PLAINTEXT after ./configure.sh
config
secrets/

# Build tree (contains a copy of upstream kali-live + staged secrets).
# ANCHORED to repo root: an unanchored `build/` also matched
# overlay/kali-config/common/hooks/build/ and silently hid the
# klh-apt-cache hook from git (caught by build.sh's provenance guard
# refusing build #26 — the hook was staged with no git source).
/build/

# Build output
output/
*.iso
*.img
*.sha512sum
*.log

# Test scratch
test/scratch/
.klh-test-*
__pycache__/
var/
